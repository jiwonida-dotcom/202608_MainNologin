# 줄바꿈 정규화 — 저장소는 LF, 체크아웃은 플랫폼 기본
* text=auto

# Windows 전용 스크립트는 CRLF 를 유지해야 한다
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# 스크립트 · 문서
*.mjs  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf

# 원본 자료는 바이너리로 다룬다 — 절대 변환하지 않는다 (Project Instructions 5절)
*.msg  binary
*.pdf  binary
*.pptx binary
*.potx binary
*.xlsx binary
*.docx binary
*.png  binary
*.jpg  binary
*.jpeg binary
